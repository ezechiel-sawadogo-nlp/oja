# Copy to .env (never commit it) or set these variables in your hosting dashboard.
# The server reads .env at start-up (no dependency); real environment variables win.

# Protects the seller workspace with HTTP Basic auth (leave empty to disable)
OJA_PASSWORD=

# Token you choose and paste into the Meta developer console to verify the webhook
WHATSAPP_VERIFY_TOKEN=

# Meta app secret: if set, incoming webhook POSTs must carry a valid X-Hub-Signature-256
WHATSAPP_APP_SECRET=
